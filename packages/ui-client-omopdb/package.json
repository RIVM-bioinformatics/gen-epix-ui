{
  "name": "@gen-epix/ui-client-omopdb",
  "version": "4.0.0",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIVM-bioinformatics/gen-epix-ui.git"
  },
  "author": "RIVM-bioinformatics <ids-bioinformatics@rivm.nl>",
  "homepage": "https://github.com/RIVM-bioinformatics/gen-epix",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./types": {
        "types": "./dist/@types/ui-client-omopdb.d.ts",
        "import": "./dist/@types/ui-client-omopdb.d.ts"
      },
      "./components/app/OmopDbApp": {
        "types": "./dist/components/app/OmopDbApp/index.d.ts",
        "import": "./dist/components/app/OmopDbApp/index.js"
      },
      "./models/config": {
        "types": "./dist/models/config.d.ts",
        "import": "./dist/models/config.js"
      },
      "./models/theme": {
        "types": "./dist/models/theme.d.ts",
        "import": "./dist/models/theme.js"
      },
      "./pages/HomePage": {
        "types": "./dist/pages/HomePage/index.d.ts",
        "import": "./dist/pages/HomePage/index.js"
      },
      "./routes": {
        "types": "./dist/routes/index.d.ts",
        "import": "./dist/routes/index.js"
      },
      "./setup/setup": {
        "types": "./dist/setup/setup.d.ts",
        "import": "./dist/setup/setup.js"
      },
      "./theme/demoTheme": {
        "types": "./dist/theme/demoTheme/index.d.ts",
        "import": "./dist/theme/demoTheme/index.js"
      },
      "./utils/OmopDbStandardConfigUtil": {
        "types": "./dist/utils/OmopDbStandardConfigUtil/index.d.ts",
        "import": "./dist/utils/OmopDbStandardConfigUtil/index.js"
      }
    }
  },
  "exports": {
    "./types": {
      "types": "./src/@types/ui-client-omopdb.d.ts",
      "import": "./src/@types/ui-client-omopdb.d.ts"
    },
    "./components/app/OmopDbApp": {
      "types": "./src/components/app/OmopDbApp/index.ts",
      "import": "./src/components/app/OmopDbApp/index.ts"
    },
    "./models/config": {
      "types": "./src/models/config.ts",
      "import": "./src/models/config.ts"
    },
    "./models/theme": {
      "types": "./src/models/theme.ts",
      "import": "./src/models/theme.ts"
    },
    "./pages/HomePage": {
      "types": "./src/pages/HomePage/index.ts",
      "import": "./src/pages/HomePage/index.ts"
    },
    "./routes": {
      "types": "./src/routes/index.ts",
      "import": "./src/routes/index.ts"
    },
    "./setup/setup": {
      "types": "./src/setup/setup.ts",
      "import": "./src/setup/setup.ts"
    },
    "./theme/demoTheme": {
      "types": "./src/theme/demoTheme/index.ts",
      "import": "./src/theme/demoTheme/index.ts"
    },
    "./utils/OmopDbStandardConfigUtil": {
      "types": "./src/utils/OmopDbStandardConfigUtil/index.ts",
      "import": "./src/utils/OmopDbStandardConfigUtil/index.ts"
    }
  },
  "scripts": {
    "update-exports": "node scripts/update-exports.js",
    "build": "vite build",
    "build-publish": "pnpm build && pnpm publish --access=public",
    "test-missing-translations": "translation-util ./ --dry-run --fail-on-missing --fail-on-stale",
    "add-missing-translations": "translation-util ./",
    "validate": "pnpm run lint && pnpm run check-types && pnpm run test-run && pnpm run test-missing-translations",
    "test": "vitest --coverage",
    "test-run": "vitest run --passWithNoTests --coverage",
    "lint": "eslint ./src --report-unused-disable-directives --max-warnings 0",
    "lint-fix": "eslint ./src --report-unused-disable-directives --max-warnings 0 --fix",
    "check-types": "tsc --noemit"
  },
  "peerDependencies": {
    "@emotion/cache": "*",
    "@emotion/react": "*",
    "@emotion/styled": "*",
    "@gen-epix/api-commondb": "workspace:^",
    "@gen-epix/api-omopdb": "workspace:^",
    "@gen-epix/ui-client-common": "workspace:^",
    "@gen-epix/ui-core-components": "workspace:^",
    "@gen-epix/ui-core-form": "workspace:^",
    "@gen-epix/ui-core": "workspace:^",
    "@mui/icons-material": "*",
    "@mui/material": "*",
    "@mui/styled-engine": "*",
    "@mui/system": "*",
    "@mui/utils": "*",
    "@mui/x-date-pickers": "*",
    "axios": "*",
    "i18next": "*",
    "react-dom": "*",
    "react-i18next": "*",
    "react": "*",
    "yup": "*"
  },
  "devDependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@gen-epix/api-commondb": "workspace:^",
    "@gen-epix/api-omopdb": "workspace:^",
    "@gen-epix/eslint-config": "0.5.0",
    "@gen-epix/translation-util": "0.2.0",
    "@gen-epix/ui-client-common": "workspace:^",
    "@gen-epix/ui-core-components": "workspace:^",
    "@gen-epix/ui-core-form": "workspace:^",
    "@microsoft/api-extractor": "7.59.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/styled-engine": "9.4.0",
    "@mui/system": "9.4.0",
    "@mui/utils": "9.4.0",
    "@mui/x-date-pickers": "9.12.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "axios": "1.20.0",
    "eslint": "10.9.1",
    "i18next": "26.4.1",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react": "19.2.8",
    "typescript": "6.0.3",
    "vite-plugin-dts": "5.1.0",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-svgr": "5.2.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yup": "1.7.1"
  },
  "browserslist": [
